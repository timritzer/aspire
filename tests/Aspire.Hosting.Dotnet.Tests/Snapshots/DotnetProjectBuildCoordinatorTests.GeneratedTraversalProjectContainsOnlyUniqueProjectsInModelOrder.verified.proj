<Project DefaultTargets="Build">
  <ItemGroup>
    <ProjectFile Include="First Project/First.csproj" />
    <ProjectFile Include="Second/Second.csproj" />
  </ItemGroup>
  <Target Name="Restore">
    <MSBuild Projects="@(ProjectFile)" Targets="Restore" BuildInParallel="true" />
  </Target>
  <Target Name="Build">
    <MSBuild Projects="@(ProjectFile)" Targets="Build" BuildInParallel="true" />
  </Target>
</Project>