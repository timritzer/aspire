@namespace Aspire.Dashboard.Components
@using System.Collections.Immutable
@inherits FluentComponentBase

@if (!Anchored)
{
    <span id="@Anchor" aria-hidden="true" style="@CursorAnchorStyle"></span>
}

@* aspire-menu-container is added to the div parent of FluentMenu, not the FluentMenu *@
<FluentMenu Class="aspire-menu-container"
            @ref="_menu"
            Trigger="@Anchor"
            OpenedChanged="OnOpenChanged"
            Style="@Style"
            PersistOnItemClick="true">
    <FluentMenuList>
        @foreach (var item in Items)
        {
            @RenderMenuItem(item)
        }
    </FluentMenuList>
</FluentMenu>

@code {
    private RenderFragment RenderMenuItem(MenuButtonItem item)
    {
        if (item.IsDivider)
        {
            return @<FluentDivider />;
        }
        else
        {
            var additionalMenuItemAttributes = new Dictionary<string, object>(item.AdditionalAttributes ?? ImmutableDictionary<string, object>.Empty)
            {
                { "title", !string.IsNullOrEmpty(item.Tooltip) ? item.Tooltip : item.Text ?? string.Empty }
            };

            return @<FluentMenuItem Id="@item.Id" Class="@item.Class" OnClick="() => HandleItemClicked(item)" CheckedChanged="isChecked => HandleItemCheckedChanged(item, isChecked)" Disabled="@item.IsDisabled" Role="@item.Role" Checked="@item.Checked" AdditionalAttributes="@additionalMenuItemAttributes" Label="@item.Text" MenuItems="@RenderNestedItems(item)">
                @if (item.Icon != null)
                {
                    <span slot="@GetIconSlot(item.Role)">
                        <FluentIcon Value="@item.Icon" Style="vertical-align: text-bottom;" Width="16px" Color="Color.Primary" />
                    </span>
                }
                @if (item.SecondaryActionIcon is not null)
                {
                    <span class="aspire-menu-secondary-action-container" slot="end">
                        <FluentButton Class="@($"aspire-menu-secondary-action{(item.IsSecondaryActionSelected ? " selected" : null)}")"
                                      Appearance="ButtonAppearance.Transparent"
                                      Title="@item.SecondaryActionAriaLabel"
                                      AriaLabel="@item.SecondaryActionAriaLabel"
                                      aria-pressed="@(item.IsSecondaryActionSelected ? "true" : "false")"
                                      @onclick="() => HandleSecondaryActionClicked(item)">
                            <FluentIcon Value="@item.SecondaryActionIcon" Width="16px" Color="Color.Primary" />
                        </FluentButton>
                    </span>
                }
            </FluentMenuItem>;
        }
    }

    private static string GetIconSlot(MenuItemRole? role) => role switch
    {
        MenuItemRole.Checkbox or MenuItemRole.Radio => "indicator",
        _ => "start"
    };

    private RenderFragment? RenderNestedItems(MenuButtonItem item)
    {
        if (item.NestedMenuItems is null || item.NestedMenuItems.Count == 0)
        {
            return null;
        }

        return @<text>
            @foreach (var nestedItem in item.NestedMenuItems)
            {
                @RenderMenuItem(nestedItem)
            }
        </text>;
    }
}
